# ============================================================
# MEGA 无人值守下载器 配置
# ============================================================

# 要下载的分享链接
SHARE_LINK=https://mega.nz/folder/I7EUnZ7Q#dXEScojKVZRvZW67oWyVfg

# MEGA 账号（留空则纯匿名）
MEGA_USER=904308289@qq.com
MEGA_PASS=xxt904308289

# 下载模式:
#   account   = 只用账号配额池
#   anonymous = 只用匿名 IP 配额池
#   auto      = 撞配额时在两个池子间自动切换（推荐，吞吐翻倍）
LOGIN_MODE=auto

# 卡死判定：多少秒无字节增长就终止并重试
STALL_SECS=120

# 单文件普通重试次数（不含配额退避）
MAX_TRY_PER_FILE=3

# 配额退避：起始 15 分钟，指数增长，上限 60 分钟
QUOTA_WAIT_MIN=900
QUOTA_WAIT_MAX=3600

# 本轮完全没有进展时的轮询间隔（秒）
IDLE_SLEEP=60

# 去重来源目录：这些目录里同名同大小的文件会被硬链接进来，不重复下载
EXTRA_SOURCE_DIRS="/root/megadl/round01"

# 心跳落盘间隔（秒）
HB_EVERY=30

# 使用隔离的 MEGAcmd 状态目录（HOME=$BASE），
# 避免影响同机上其它 MEGAcmd 实例
MEGA_ISOLATED_HOME=1
